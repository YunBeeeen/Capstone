<?xml version="1.0"?>
<!--
  임시 시험용 로봇 — 월드·카메라·VSLAM 파이프라인 확인용. 실제 로봇 단순화 모델이 오면 그걸로 바꿈 (robot:=<xacro 경로>).
  박스 차체 (스워브 베이스 크기 대략) + 마스트 + ZED 2i 흉내 (높이 cam_z, 아래로 cam_pitch).
-->
<robot name="test_rig" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="cam_z" default="1.0"/>      <!-- 바닥에서 카메라 높이 [m] (리프트 최저 ≈ 0.72, 최고 ≈ 1.37) -->
  <xacro:arg name="cam_pitch" default="0.26"/> <!-- 아래로 [rad] (0.26 ≈ 15°) -->
  <xacro:include filename="$(find capstone_gazebo)/urdf/sim_sensors.xacro"/>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><box size="0.40 0.32 0.30"/></geometry>
      <material name="rig_blue"><color rgba="0.2 0.35 0.6 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry><box size="0.40 0.32 0.30"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.05 0 ${($(arg cam_z) - 0.03) / 2}"/>
      <geometry><box size="0.06 0.06 ${$(arg cam_z) - 0.03}"/></geometry>
      <material name="rig_grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="20.0"/>
      <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <xacro:zed2i_sim parent="base_link" xyz="0.0 0 ${$(arg cam_z) - 0.03}" rpy="0 $(arg cam_pitch) 0"/>
  <xacro:planar_move_sim base="base_footprint"/>
  <xacro:ground_truth_sim body="base_footprint"/>
  <xacro:no_gravity link="base_link"/>
</robot>
