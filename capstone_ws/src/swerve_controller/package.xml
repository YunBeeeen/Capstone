<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swerve_controller</name>
  <version>0.1.0</version>
  <description>4모듈 스워브 기구학 (cmd_vel → 조향 RobStride 02 ×4 + 구동 BL41105 ×4). ksrc 로버 펌웨어 IK 포팅</description>
  <maintainer email="djadbsqls120@hanyang.ac.kr">eomyunbeen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pybind11_vendor</build_depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>capstone_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
