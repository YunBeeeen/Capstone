Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 225; 230; 235
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 40
      Reference Frame: odom
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Odometry
      Name: GroundTruth
      Enabled: true
      Topic:
        Value: /sim/ground_truth
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Shaft Length: 0.15
        Shaft Radius: 0.01
        Head Length: 0.05
        Head Radius: 0.025
      Covariance:
        Value: false
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Target Frame: base_link
      Distance: 2.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.45
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 800
