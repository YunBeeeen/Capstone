<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>capstone_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Classic 11 — 학교 층 월드(school_floor) + ZED 2i 흉내 센서 매크로. VSLAM(RTAB-Map) / Nav2 파이프라인 시험용 (스워브 물리는 capstone_sim/MuJoCo)</description>
  <maintainer email="djadbsqls120@hanyang.ac.kr">eomyunbeen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>capstone_teleop</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
