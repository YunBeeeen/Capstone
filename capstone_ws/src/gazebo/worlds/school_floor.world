<?xml version="1.0"?>
<!-- make_world.py 가 생성 — 직접 고치지 말 것 (배치는 build(), 텍스처는 make_textures()) -->
<sdf version="1.6">
  <world name="school_floor">
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>
    <!-- 해·바닥을 직접 정의 (model://sun, ground_plane 을 찾다가 온라인 DB 조회로 멈추는 일 없게) -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>10 6 10 0 0 0</pose>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.3 0.5 -1</direction>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision>
      <visual name="v"><cast_shadows>false</cast_shadows><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        <material><ambient>0.45 0.47 0.45 1</ambient><diffuse>0.45 0.47 0.45 1</diffuse></material></visual>
    </link></model>
    <!-- /gazebo/set_entity_state, get_entity_state — 시험 때 로봇 순간이동 / 참값 조회 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>10 -6 16 0 0.95 1.5708</pose>
      </camera>
    </gui>
<model name="wall_1"><static>true</static><pose>0.978 0.000 0 0 0 0.0000</pose><link name="link"><visual name="v0"><pose>0.000 0.000 1.300 0.0000 0.0000 0.0000</pose><geometry><box><size>2.256 0.150 2.600</size></box></geometry><material><script><uri>model://capstone_materials/materials/scripts</uri><uri>model://capstone_materials/materials/textures</uri><name>Capstone/wall_corridor_a</name></script></material><cast_shadows>false</cast_shadows></visual><collision name="c0"><pose>0.000 0.000 1.300 0.0000 0.0000 0.0000</pose><geometry><box><size>2.256 0.150 2.600</size></box></geometry></collision></link></model>
