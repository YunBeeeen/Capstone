// make_world.py 가 생성 — 직접 고치지 말 것
material Capstone/wall_corridor_a
{
  technique
  {
    pass
    {
      ambient 0.9 0.9 0.9 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.05 0.05 0.05 1.0 10
      texture_unit
      {
        texture wall_corridor_a.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

