<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>capstone_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo 시뮬 — 조향/구동 브리지 자리를 대신해서 swerve_controller 를 실기와 같은 토픽으로 시험</description>
  <maintainer email="djadbsqls120@hanyang.ac.kr">eomyunbeen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>capstone_msgs</exec_depend>
  <exec_depend>mobile_robot_right_arm_description</exec_depend>
  <exec_depend>swerve_controller</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>capstone_teleop</exec_depend>
  <!-- mujoco 는 pip (python3 -m pip install mujoco) — rosdep 키 없음 -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
